# Copy to application-local.properties for local development (gitignored).
# Railway: set these in the Railway dashboard → Variables instead.

# --- Database (local MySQL) ---
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smart_schoolapp?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your-mysql-password-here

# --- Spring profile for cloud demo (set on Railway) ---
# SPRING_PROFILES_ACTIVE=prod

# --- Demo login passwords (choose strong values for public demos) ---
APP_DEMO_STUDENT_PASSWORD=change-me-student
APP_DEMO_PARENT_PASSWORD=change-me-parent
APP_DEMO_STAFF_SUPERADMIN_PASSWORD=change-me-superadmin
APP_DEMO_STAFF_ADMIN_PASSWORD=change-me-admin
APP_DEMO_STAFF_TEACHER_PASSWORD=change-me-teacher
APP_DEMO_STAFF_ACCOUNTANT_PASSWORD=change-me-accountant
APP_DEMO_STAFF_RECEPTIONIST_PASSWORD=change-me-receptionist
APP_DEMO_STAFF_LIBRARIAN_PASSWORD=change-me-librarian

# --- Uploads (Railway: mount a volume at /data/uploads and set APP_UPLOAD_DIR=/data/uploads) ---
# APP_UPLOAD_DIR=/data/uploads

# --- Optional ---
# APP_DATABASE_BOOTSTRAP=auto
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

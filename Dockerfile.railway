# Railway builds on its own network; local corporate certificates are not needed.
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY src ./src
# No cache mount: Railway requires a service-specific cache ID.
RUN mvn -B -ntp clean package -DskipTests

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
RUN groupadd -r spring && useradd -r -g spring spring \
    && mkdir -p /data/uploads \
    && chown -R spring:spring /data/uploads
COPY --from=build /app/target/smart-school-*.jar app.jar
USER spring
EXPOSE 8080
ENV SPRING_PROFILES_ACTIVE=prod APP_UPLOAD_DIR=/data/uploads
ENTRYPOINT ["java", "-jar", "app.jar"]
